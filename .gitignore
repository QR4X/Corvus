# OS
.DS_Store
Thumbs.db

# Editors / IDEs / agent tooling
.vscode/
.idea/
*.swp
.kilo/

# Env / secrets
.env
.env.*
!.env.example

# Logs / temp
*.log
*.tmp

# Node
node_modules/
npm-debug.log
yarn-error.log

# Build output. Not versioned: what Obsidian installs comes from the GitHub
# Release, which the workflow builds from scratch on every tag - the README
# tells users to download from there, and the automated review rebuilds the
# source to verify it byte for byte. Versioning it only made every CSS lint
# finding count twice.
output/

# Local config (dev vault path, etc.)
.axxa.local.json

# Test Obsidian vault config (not part of the plugin)
.obsidian/

# Internal planning / orientation docs (not part of the public repo
# nor of the Obsidian submission). They stay on the dev's disk, out of git.
# README.md is public and stays tracked.
ACTION-PLAN.md
QA-CHECKLIST.md
DESIGN-SYSTEM.md
MASTER-PLAN.md
PROMPT-MESTRE.md
VIABILIDADE-FINANCEIRA.md

# Preview shell (npm run preview): bundle + app.css extracted from the
# installed Obsidian. app.css belongs to the app and must not be versioned.
scripts/preview/.out/

# Storybook build (generated by `npm run storybook`)
storybook/dist/
storybook-static/
.sb-shots/

# Cloudflare tunnel credentials (TunnelSecret - NEVER version)
cloudflared/

# Audit/reconcile scratch (do not version)
.audit-*.cjs
.audit-*.mjs
.recon-*.json
.recon-*.cjs

# Temporary Storybook screenshot helper (Linux container)
scripts/_shot.cjs
